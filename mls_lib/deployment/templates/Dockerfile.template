FROM python:3.11-slim
WORKDIR /app
ARG MODEL_FILENAME
COPY artifacts/deployment/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY artifacts/deployment/deployment_config.json ./deployment_config.json
COPY artifacts/${MODEL_FILENAME} ./artifacts/${MODEL_FILENAME}
# Deployment-only image. Serving entrypoint is provided by a future task.
CMD ["python", "-c", "print('Model artifact image built successfully')"]
